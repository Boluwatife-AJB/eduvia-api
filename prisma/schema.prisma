generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id               String            @id @default(uuid())
  name             String
  slug             String            @unique
  /// Short code used in matric/employee IDs (e.g. GFA for Greenfield Academy). Falls back to slug if not set.
  initials         String?           @map("initials")
  email            String?
  phone            String?
  address          String?
  logo             String?
  status           TenantStatus      @default(ACTIVE)
  plan             String            @default("free")
  config           Json              @default("{}")
  createdAt        DateTime          @default(now()) @map("created_at")
  deletedAt        DateTime?         @map("deleted_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  users            User[]
  academicSessions AcademicSession[]
  academicTerms    AcademicTerm[]
  departments      Department[]
  classes          Class[]
  subjects         Subject[]

  @@map("tenants")
}

model User {
  id              String           @id @default(uuid())
  role            UserRole
  /// Human-readable login ID: students = matricNumber, teachers/staff = employeeId, guardians = custom ID. Unique per tenant.
  identifier      String           @unique
  email           String?
  phone           String?
  avatar          String?
  status          UserStatus       @default(PENDING)
  firstName       String           @map("first_name")
  lastName        String           @map("last_name")
  mfaEnabled      Boolean          @default(false)
  mfaSecret       String?          @map("mfa_secret")
  passwordHash    String           @map("password_hash")
  relationship    String?
  createdAt       DateTime         @default(now()) @map("created_at")
  lastLoginAt     DateTime?        @map("last_login_at")
  tenantId        String           @map("tenant_id")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  guardianProfile GuardianProfile?
  refreshTokens   RefreshToken[]
  staffProfile    StaffProfile?
  studentProfile  StudentProfile?
  teacherProfile  TeacherProfile?
  tenant          Tenant           @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, identifier])
  @@unique([tenantId, email])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

/// id = internal UUID. userId = FK to User. matricNumber = display ID (e.g. GFA/2026/0001), same as User.identifier for students.
model StudentProfile {
  id            String    @id @default(uuid())
  userId        String    @unique @map("user_id")
  tenantId      String    @map("tenant_id")
  matricNumber  String    @unique @map("matric_number")
  classId       String    @map("class_id")
  admissionDate DateTime? @map("admission_date")
  dateOfBirth   DateTime? @map("date_of_birth")
  guardianIds   String[]  @default([]) @map("guardian_ids")

  user                        User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  class                       Class?                       @relation(fields: [classId], references: [id])
  studentSubjectRegistrations StudentSubjectRegistration[]

  @@map("student_profiles")
}

/// id = internal UUID. userId = FK to User. employeeId = display ID (e.g. GFA/TCH/001), same as User.identifier for teachers.
model TeacherProfile {
  id            String    @id @default(uuid())
  userId        String    @unique @map("user_id")
  tenantId      String    @map("tenant_id")
  employeeId    String    @unique @map("employee_id")
  departmentId  String?   @map("department_id")
  qualification String?   @map("qualification")
  dateJoined    DateTime? @map("date_joined")
  // subjectIds    String[]  @default([]) @map("subject_ids")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("teacher_profiles")
}

/// id = internal UUID. userId = FK to User. Guardians use User.identifier (no separate employee/matric field).
model GuardianProfile {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  tenantId     String   @map("tenant_id")
  occupation   String?  @map("occupation")
  relationship String?  @map("relationship")
  wardIds      String[] @default([]) @map("ward_ids")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("guardian_profiles")
}

/// id = internal UUID. userId = FK to User. employeeId = display ID (e.g. GFA/EMP/001), same as User.identifier for staff.
model StaffProfile {
  id           String    @id @default(uuid())
  userId       String    @unique @map("user_id")
  tenantId     String    @map("tenant_id")
  employeeId   String    @unique @map("employee_id")
  staffType    String    @map("staff_type")
  departmentId String?   @map("department_id")
  dateJoined   DateTime? @map("date_joined")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("staff_profiles")
}

model AcademicSession {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String   @map("name")
  startDate DateTime @map("start_date")
  endDate   DateTime @map("end_date")
  isCurrent Boolean  @default(false) @map("is_current")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant         @relation(fields: [tenantId], references: [id])
  // semesters        AcademicSemester[] // For uni
  terms  AcademicTerm[] // For secondary

  @@unique([tenantId, name]) // can't have two sessions with same name in one school
  @@map("academic_sessions")
}

model AcademicTerm {
  id                   String                       @id @default(uuid())
  tenantId             String                       @map("tenant_id")
  academicSessionId    String                       @map("academic_session_id")
  name                 String                       @map("name")
  startDate            DateTime                     @map("start_date")
  endDate              DateTime                     @map("end_date")
  isCurrent            Boolean                      @default(false) @map("is_current")
  createdAt            DateTime                     @default(now()) @map("created_at")
  updatedAt            DateTime                     @updatedAt @map("updated_at")
  subjectRegistrations StudentSubjectRegistration[]

  tenant          Tenant          @relation(fields: [tenantId], references: [id])
  academicSession AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Cascade)

  @@unique([academicSessionId, name]) // can't have two terms with same name in one session
  @@map("academic_terms")
}

model Department {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  name        String  @map("name")
  description String? @map("description")
  hodId       String? @map("hod_id")

  subjects Subject[]
  classes  Class[]

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@map("departments")
}

model Class {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  name           String
  level          String
  capacity       Int     @default(40)
  departmentId   String? @map("department_id")
  classTeacherId String? @map("class_teacher_id") // the teacher responsible for this class

  tenant        Tenant           @relation(fields: [tenantId], references: [id])
  department    Department?      @relation(fields: [departmentId], references: [id])  
  students      StudentProfile[]
  classSubjects ClassSubject[]    // subjects offered in this class

  @@unique([tenantId, name])
  @@map("classes")
}

model Subject {
  id           String  @id @default(uuid())
  tenantId     String  @map("tenant_id")
  name         String
  code         String
  title        String
  description  String?
  departmentId String? @map("department_id")

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  department    Department?    @relation(fields: [departmentId], references: [id])
  classSubjects ClassSubject[] // which classes offer this subject

  @@unique([tenantId, code, departmentId])
  @@map("subjects")
}

model ClassSubject {
  id          String      @id @default(uuid())
  tenantId    String      @map("tenant_id")
  classId     String      @map("class_id")
  subjectId   String      @map("subject_id")
  subjectType SubjectType @default(COMPULSORY)
  // createdAt DateTime @default(now()) @map("created_at")
  // updatedAt DateTime @updatedAt @map("updated_at")

  class                       Class                        @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject                     Subject                      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teachers                    SubjectTeacher[]
  studentSubjectRegistrations StudentSubjectRegistration[]

  @@unique([tenantId, classId, subjectId])
  @@map("class_subjects")
}

model SubjectTeacher {
  id             String @id @default(uuid())
  tenantId       String @map("tenant_id")
  classSubjectId String @map("class_subject_id")
  teacherId      String @map("teacher_id")

  classSubject ClassSubject @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)

  @@unique([tenantId, classSubjectId, teacherId])
  @@map("subject_teachers")
}

model StudentSubjectRegistration {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  studentId        String   @map("student_id")
  classSubjectId   String   @map("class_subject_id")
  termId           String   @map("term_id")
  registrationDate DateTime @default(now()) @map("registration_date")

  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classSubject ClassSubject   @relation(fields: [classSubjectId], references: [id])
  term         AcademicTerm   @relation(fields: [termId], references: [id])

  @@unique([tenantId, studentId, classSubjectId, termId])
  @@map("student_subject_registrations")
}

enum UserRole {
  STUDENT
  TEACHER
  ASST_TEACHER
  PARENT
  SCHOOL_OWNER
  PRINCIPAL
  HEAD_TEACHER
  VICE_PRINCIPAL
  ASST_HEAD_TEACHER
  HOD
  COUNSELOR
  LAB_ATTENDANT
  NURSE
  LIBRARIAN
  BURSAR
  SUPPORT_STAFF
  SECURITY_OFFICER
  SUPER_ADMIN
  GUARDIAN
  OTHER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
  PENDING
  BLOCKED
  DELETED
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum SubjectType {
  COMPULSORY
  ELECTIVE
  OPTIONAL
}
