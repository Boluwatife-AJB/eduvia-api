generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                String            @id @default(uuid())
  name              String
  slug              String            @unique
  /// Short code used in matric/employee IDs (e.g. GFA for Greenfield Academy). Falls back to slug if not set.
  initials          String?
  email             String?
  phone             String?
  address           String?
  logo              String?
  status            TenantStatus      @default(ACTIVE)
  plan              String            @default("free")
  config            Json              @default("{}")
  created_at        DateTime          @default(now())
  deleted_at        DateTime?
  updated_at        DateTime          @updatedAt
  users             User[]
  academic_sessions AcademicSession[]
  academic_terms    AcademicTerm[]
  departments       Department[]
  classes           Class[]
  subjects          Subject[]
  timeTableSlots    TimeTableSlot[]
  tutorialClasses   TutorialClass[]

  @@map("tenants")
}

model User {
  id               String           @id @default(uuid())
  role             UserRole
  /// Human-readable login ID: students = matricNumber, teachers/staff = employeeId, guardians = custom ID. Unique per tenant.
  identifier       String           @unique
  email            String?
  phone            String?
  avatar           String?
  status           UserStatus       @default(PENDING)
  first_name       String
  last_name        String
  mfa_enabled      Boolean          @default(false)
  mfa_secret       String?
  password_hash    String
  relationship     String?
  created_at       DateTime         @default(now())
  last_login_at    DateTime?
  tenant_id        String
  updated_at       DateTime         @updatedAt
  guardian_profile GuardianProfile?
  refresh_tokens   RefreshToken[]
  staff_profile    StaffProfile?
  student_profile  StudentProfile?
  teacher_profile  TeacherProfile?
  tenant           Tenant           @relation(fields: [tenant_id], references: [id])

  @@unique([tenant_id, identifier])
  @@unique([tenant_id, email])
  @@map("users")
}

model RefreshToken {
  id         String   @id @default(uuid())
  token      String   @unique
  created_at DateTime @default(now())
  expires_at DateTime
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

/// id = internal UUID. userId = FK to User. matricNumber = display ID (e.g. GFA/2026/0001), same as User.identifier for students.
model StudentProfile {
  id                          String                       @id @default(uuid())
  user_id                     String                       @unique
  tenant_id                   String
  matric_number               String                       @unique
  class_id                    String?
  admission_date              DateTime?
  date_of_birth               DateTime?
  guardian_ids                String[]                     @default([])
  /// Denormalized Subject.id list; keep in sync with StudentSubjectRegistration or derive via query.
  registered_subject_ids      String[]                     @default([])
  studentSubjectRegistrations StudentSubjectRegistration[]

  user  User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  class Class? @relation(fields: [class_id], references: [id])

  @@map("student_profiles")
}

/// id = internal UUID. userId = FK to User. employeeId = display ID (e.g. GFA/TCH/001), same as User.identifier for teachers.
model TeacherProfile {
  id                   String    @id @default(uuid())
  user_id              String    @unique
  tenant_id            String
  employee_id          String    @unique
  department_id        String?
  qualification        String?
  date_joined          DateTime?
  /// Denormalized Subject.id list; keep in sync with SubjectTeacher → ClassSubject or derive via query.
  assigned_subject_ids String[]  @default([])

  user            User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  tutorialClasses TutorialClass[]

  @@map("teacher_profiles")
}

/// id = internal UUID. userId = FK to User. Guardians use User.identifier (no separate employee/matric field).
model GuardianProfile {
  id           String   @id @default(uuid())
  user_id      String   @unique
  tenant_id    String
  occupation   String?
  relationship String?
  ward_ids     String[] @default([])
  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("guardian_profiles")
}

/// id = internal UUID. userId = FK to User. employeeId = display ID (e.g. GFA/EMP/001), same as User.identifier for staff.
model StaffProfile {
  id            String    @id @default(uuid())
  user_id       String    @unique
  tenant_id     String
  employee_id   String    @unique
  staff_type    String
  department_id String?
  date_joined   DateTime?
  user          User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("staff_profiles")
}

model AcademicSession {
  id         String   @id @default(uuid())
  tenant_id  String
  name       String
  start_date DateTime
  end_date   DateTime
  is_current Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  tenant Tenant         @relation(fields: [tenant_id], references: [id])
  // semesters        AcademicSemester[] // For uni
  terms  AcademicTerm[] // For secondary

  @@unique([tenant_id, name]) // can't have two sessions with same name in one school
  @@map("academic_sessions")
}

model AcademicTerm {
  id                    String                       @id @default(uuid())
  tenant_id             String
  academic_session_id   String
  name                  String
  start_date            DateTime
  end_date              DateTime
  is_current            Boolean                      @default(false)
  created_at            DateTime                     @default(now())
  updated_at            DateTime                     @updatedAt
  subject_registrations StudentSubjectRegistration[]

  tenant          Tenant          @relation(fields: [tenant_id], references: [id])
  academicSession AcademicSession @relation(fields: [academic_session_id], references: [id], onDelete: Cascade)
  timeTableSlots  TimeTableSlot[]
  tutorialClasses TutorialClass[]

  @@unique([academic_session_id, name]) // can't have two terms with same name in one session
  @@map("academic_terms")
}

model Department {
  id          String  @id @default(uuid())
  tenant_id   String
  name        String
  description String?
  hod_id      String?

  subjects Subject[]
  classes  Class[]

  tenant Tenant @relation(fields: [tenant_id], references: [id])

  @@unique([tenant_id, name])
  @@map("departments")
}

model Class {
  id               String   @id @default(uuid())
  tenant_id        String
  name             String
  level            String
  capacity         Int      @default(40)
  department_id    String?
  class_teacher_id String? // the teacher responsible for this class
  /// Denormalized Subject.id list; keep in sync with ClassSubject or derive via query.
  subject_ids      String[] @default([])

  tenant         Tenant           @relation(fields: [tenant_id], references: [id])
  department     Department?      @relation(fields: [department_id], references: [id])
  students       StudentProfile[]
  classSubjects  ClassSubject[] // subjects offered in this class
  timeTableSlots TimeTableSlot[]

  @@unique([tenant_id, name])
  @@map("classes")
}

model Subject {
  id            String  @id @default(uuid())
  tenant_id     String
  name          String
  code          String
  title         String
  description   String?
  department_id String?

  tenant          Tenant          @relation(fields: [tenant_id], references: [id])
  department      Department?     @relation(fields: [department_id], references: [id])
  classSubjects   ClassSubject[] // which classes offer this subject
  timeTableSlots  TimeTableSlot[]
  tutorialClasses TutorialClass[]

  @@unique([tenant_id, code, department_id])
  @@map("subjects")
}

model ClassSubject {
  id           String      @id @default(uuid())
  tenant_id    String
  class_id     String
  subject_id   String
  subject_type SubjectType @default(COMPULSORY)

  class                         Class                        @relation(fields: [class_id], references: [id], onDelete: Cascade)
  subject                       Subject                      @relation(fields: [subject_id], references: [id], onDelete: Cascade)
  teachers                      SubjectTeacher[]
  student_subject_registrations StudentSubjectRegistration[]

  @@unique([tenant_id, class_id, subject_id])
  @@map("class_subjects")
}

model SubjectTeacher {
  id               String @id @default(uuid())
  tenant_id        String
  class_subject_id String
  teacher_id       String

  classSubject ClassSubject @relation(fields: [class_subject_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, class_subject_id, teacher_id])
  @@map("subject_teachers")
}

model StudentSubjectRegistration {
  id                String   @id @default(uuid())
  tenant_id         String
  student_id        String
  class_subject_id  String
  term_id           String
  registration_date DateTime @default(now())

  student      StudentProfile @relation(fields: [student_id], references: [id], onDelete: Cascade)
  classSubject ClassSubject   @relation(fields: [class_subject_id], references: [id])
  term         AcademicTerm   @relation(fields: [term_id], references: [id])

  @@unique([tenant_id, student_id, class_subject_id, term_id])
  @@map("student_subject_registrations")
}

model TimeTableSlot {
  id               String    @id @default(uuid())
  tenant_id        String
  class_id         String
  subject_id       String
  teacher_id       String
  academic_term_id String
  day_of_week      DayOfWeek
  start_time       String // HH:MM
  end_time         String
  venue            String?
  is_active        Boolean   @default(true)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  tenant  Tenant       @relation(fields: [tenant_id], references: [id])
  class   Class        @relation(fields: [class_id], references: [id], onDelete: Cascade)
  subject Subject      @relation(fields: [subject_id], references: [id])
  term    AcademicTerm @relation(fields: [academic_term_id], references: [id])

  // @@unique([tenant_id, class_id, subject_id, teacher_id, academic_term_id, day_of_week, start_time, end_time])
  @@map("timetable_slots")
}

// Extra classes created by teachers outside of the regular timetable
model TutorialClass {
  id               String     @id @default(uuid())
  tenant_id        String
  teacher_id       String
  class_id         String?
  subject_id       String
  academic_term_id String
  title            String
  description      String?
  venue            String?
  start_time       DateTime
  end_time         DateTime
  is_recurring     Boolean    @default(false)
  recurring_day    DayOfWeek?
  max_students     Int?
  created_at       DateTime   @default(now())
  updated_at       DateTime   @updatedAt

  tenant           Tenant          @relation(fields: [tenant_id], references: [id])
  subject          Subject         @relation(fields: [subject_id], references: [id])
  term             AcademicTerm    @relation(fields: [academic_term_id], references: [id])
  teacherProfile   TeacherProfile? @relation(fields: [teacherProfileId], references: [id])
  teacherProfileId String?

  @@map("tutorial_classes")
}

enum UserRole {
  STUDENT
  TEACHER
  ASST_TEACHER
  PARENT
  SCHOOL_OWNER
  PRINCIPAL
  HEAD_TEACHER
  VICE_PRINCIPAL
  ASST_HEAD_TEACHER
  HOD
  COUNSELOR
  LAB_ATTENDANT
  NURSE
  LIBRARIAN
  BURSAR
  SUPPORT_STAFF
  SECURITY_OFFICER
  SUPER_ADMIN
  GUARDIAN
  OTHER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
  PENDING
  BLOCKED
  DELETED
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum SubjectType {
  COMPULSORY
  ELECTIVE
  OPTIONAL
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}
